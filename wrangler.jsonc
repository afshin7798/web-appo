{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7472db77-333d-4220-88e3-147438bc891f","database_name": "web-appo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c186bfcca0434bca8d2445a8583546b1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
